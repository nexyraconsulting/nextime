# NexHR server environment. Copy this file to server/.env and fill in every REQUIRED value.
#   cp .env.example server/.env && chmod 600 server/.env
# Never commit server/.env. No real secrets belong in this file.
# Full explanation of each value: CONFIGURATION_CHECKLIST.md

# ---------- Required ----------
NODE_ENV=production
PORT=8080
# Workspaces are served at <workspace>.BASE_DOMAIN, the marketing site at www.BASE_DOMAIN.
# Must match baseDomain in assets/js/appConfig.js.
BASE_DOMAIN=nexhr.com
# The API connects as the nexyra_app role created by database/rls_and_roles.sql (not the table owner).
DATABASE_URL=postgres://nexyra_app:REPLACE_WITH_DB_PASSWORD@REPLACE_WITH_DB_HOST:5432/nexhr
# 32+ random bytes, e.g. `openssl rand -base64 48`. Encrypts TOTP secrets and bank details.
# Back it up separately from the database. If it is lost, encrypted data cannot be recovered.
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
# Signs short-lived file download links. Another 32+ random bytes.
FILE_URL_SECRET=REPLACE_WITH_RANDOM_SECRET
# Private folder for uploaded files (payslips, letters, documents). Outside the web root. Writable by the service user.
STORAGE_DIR=/var/lib/nexhr_storage
# Outgoing email: verification codes, invitations, password resets, trial reminders.
SMTP_URL=smtps://REPLACE_WITH_SMTP_USER:REPLACE_WITH_SMTP_PASSWORD@smtp.example.com:465
MAIL_FROM=NexHR <no-reply@nexhr.com>

# ---------- Required for billing ----------
# Without these the app runs, but Plan & billing returns 503 billing_not_configured.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Per-employee Price IDs. Each Price has currency_options for GBP, EUR and USD.
STRIPE_PRICE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_YEARLY=price_REPLACE_ME

# ---------- Optional ----------
# on = Stripe Tax adds VAT / sales tax at checkout (Stripe Tax must be enabled on the account)
STRIPE_TAX=off
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# on = new uploads are held (scan_pending) until a virus scanner sets files.scanned_ok. Leave off unless a scanner is wired in.
VIRUS_SCAN=off
# Only if the front end is served from a different origin than the API. Comma-separated, e.g. https://www.nexhr.com
CORS_ORIGINS=
